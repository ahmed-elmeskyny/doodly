# Optional: Google Apps Script deployment URL. Restart after editing.
NEXT_PUBLIC_GOOGLE_SHEETS_WEBHOOK_URL=
# Prefer this server-only variable when possible; takes precedence over the public one.
GOOGLE_SHEETS_WEBHOOK_URL=
# Telegram Bot API credentials. Keep both server-side and never prefix them with NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Set to the real storefront origin for production Open Graph URLs.
SITE_URL=http://localhost:3000
# Meta Pixel and Conversions API. The token is server-only.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Optional while validating events in Meta Events Manager; remove after testing.
META_CAPI_TEST_EVENT_CODE=
# Update only when moving to another supported Graph API version.
META_GRAPH_API_VERSION=v26.0
